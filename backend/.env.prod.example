# ── Production environment variables ──────────────────────────────────────────
# Copy this file to .env.prod and fill in real values.
# NEVER commit .env.prod to git.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_hex(32))">

# Database (password must match DB_PASSWORD in docker-compose.prod.yml)
DATABASE_URL=postgresql+asyncpg://erp_user:<DB_PASSWORD>@db:5432/mini_erp
DATABASE_URL_SYNC=postgresql://erp_user:<DB_PASSWORD>@db:5432/mini_erp

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage (Docker volumes — keep these paths)
MODELS_DIR=/app/models_store
UPLOAD_DIR=/app/uploads

# Logging
LOG_LEVEL=WARNING

# LLM provider — choose one: groq | anthropic | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Embeddings (Ollama runs in the same Docker network)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Only needed if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

MAX_SQL_ROWS=500
CHAT_HISTORY_LIMIT=20

# CORS — set to your domain or VM IP
CORS_ORIGINS=["http://<VM-IP>","http://localhost"]
